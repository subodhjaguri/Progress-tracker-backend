# Copy to .env and fill in values. .env is gitignored.

PORT=4000
NODE_ENV=development

# Hosted MongoDB (e.g. MongoDB Atlas) connection string
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/progress_tracker

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# storage: local (dev) | s3 (prod)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# AWS S3 — only needed when STORAGE_DRIVER=s3
AWS_REGION=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Seed (used by `npm run seed` from Phase 2)
SEED_SUPERADMIN_NAME=Owner
SEED_SUPERADMIN_MOBILE=9999999999
SEED_SUPERADMIN_PASSWORD=change-me
